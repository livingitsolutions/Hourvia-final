# Names only. Set real values as protected (secret) Netlify environment variables scoped to
# Deploy Previews / Branch deploys of the NONPRODUCTION environment. Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# >= 32 random characters; keys HMACs for rate-limit buckets and audit email/IP fields.
HOURVIA_AUTH_HASH_KEY=
# https origin used for invitation/recovery redirects, e.g. the deploy-preview URL.
HOURVIA_APP_ORIGIN=
# Must be exactly "true" before any invitation or recovery email is sent.
HOURVIA_EMAIL_DELIVERY_AUTHORIZED=false
# Optional: HOURVIA_SESSION_IDLE_SECONDS (default 1800), HOURVIA_SESSION_ABSOLUTE_SECONDS (default 43200)
# Production stays fail-closed unless HOURVIA_AUTH_ALLOW_PRODUCTION=true (do not set in Sprint 1.7).
