# Names only. Set real values in Netlify, scoped to the PRODUCTION context and the functions scope only,
# marked secret where noted. Never prefix with VITE_ (VITE_ values can be inlined into browser code).
# See docs/production-prelaunch.md for when each value is set.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# secret. Legacy names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are still accepted as fallbacks.
SUPABASE_SECRET_KEY=
# secret; >= 32 random characters; keys HMACs for rate-limit buckets and audit email/IP fields.
HOURVIA_AUTH_HASH_KEY=
# Must equal the Supabase Site URL exactly: https://hourvia.livingitsolutions.com
HOURVIA_APP_ORIGIN=
# Only the smoke stage is accepted during pre-launch; general/public access is rejected.
HOURVIA_AUTH_LAUNCH_STAGE=
# secret; comma-separated designated test mailboxes (1-20). Required when the stage is "smoke".
HOURVIA_AUTH_SMOKE_TEST_EMAILS=
# Must be exactly "true" before recovery email is sent. Invitations remain blocked in pre-launch.
HOURVIA_EMAIL_DELIVERY_AUTHORIZED=false
# Production kill switch: auth returns 503 unless this is exactly "true".
HOURVIA_AUTH_ALLOW_PRODUCTION=
# Optional: HOURVIA_SESSION_IDLE_SECONDS (default 1800), HOURVIA_SESSION_ABSOLUTE_SECONDS (default 43200)

# Server-only production prerequisites; no default values. See docs/production-prelaunch.md.
# Exact synthetic email/member/provider ID mapping plus nonempty protected identity sets.
HOURVIA_SYNTHETIC_IDENTITY_POLICY=
# secret; independent site/commit/target/catalog/migration-history attestation with a smoke window of at most 7 days.
HOURVIA_PRODUCTION_DATABASE_EVIDENCE=
