-- Reviewed, one-time bootstrap of the first ThriveSource Workspace Admin (EXAMPLE — DO NOT AUTO-APPLY).
-- Invitation-only onboarding needs one admin to exist. This does NOT migrate any Netlify Identity
-- account or password. Steps:
--   1. In the NONPRODUCTION Supabase project: Authentication → Users → "Invite user" for the admin email.
--      (Uses the Hourvia invite template, so the link points at /accept-invite and is consumed server-side.)
--   2. Copy the new user's UUID and run the statement below, with real values, against the matching
--      nonproduction database after the 001 proposal has been promoted.
--   3. The admin opens the email, sets their own password, then signs in.
WITH member AS (
  INSERT INTO workspace_members (workspace_id, auth_user_id, email, display_name, role, status)
  VALUES ('thrivesource', '<SUPABASE_USER_UUID>', lower('<admin@example.com>'), '<Display Name>', 'workspace_admin', 'invited')
  RETURNING id, email
)
INSERT INTO workspace_invitations (workspace_id, member_id, email, role, status, invited_by_member_id, expires_at)
SELECT 'thrivesource', id, email, 'workspace_admin', 'pending', NULL, now() + interval '7 days' FROM member;
